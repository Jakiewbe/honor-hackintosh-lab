@@ -92,6 +92,7 @@
     bool eventBusy, eventWanted, closing;
     bool deferredCounted; // Only a refused backend close contributes to the old teardown counter.
     volatile int eventsAvailable;
+    struct nvkms_per_open *nextOverflow; // Retained close when the deferred table is full.
 };
 
 static void kms_kapi_event_fire(thread_call_param_t p0, thread_call_param_t)
@@ -179,13 +180,42 @@
     kms_deferred_try_free_impl,
 };
 
+/*
+ * A close that does not fit the fixed deferred table used to be retained with no owner and reclaimed never.
+ * These wrappers are linked intrusively instead, so the same retry path can still finish them once the table
+ * has room again. The list is only touched under gKmsLock and only while the GPU is running.
+ */
+static struct nvkms_per_open *gKmsCloseOverflow;
+static unsigned gKmsCloseOverflowCount;
+
+static void kms_close_overflow_drain_locked(void)
+{
+    struct nvkms_per_open **link = &gKmsCloseOverflow;
+
+    while (*link != NULL) {
+        struct nvkms_per_open *popen = *link;
+
+        if (popen->data != NULL) {
+            kms_deferred_close_impl(popen->data, NULL);
+            popen->data = NULL;
+        }
+        if (kms_deferred_try_free_impl(popen, NULL) != 0) {
+            *link = popen->nextOverflow;
+            gKmsCloseOverflowCount--;
+            continue;
+        }
+        link = &popen->nextOverflow;
+    }
+}
+
 static void kms_close_retry_fire(thread_call_param_t, thread_call_param_t)
 {
     IOLockLock(gKmsLock);
     gKmsCloseRetryArmed = false;
     if (gKmsCloseRetryReady && !gKmsSuspendPending && gKmsPmState == kKmsPmRunning) {
         kms_deferred_drain(&kKmsDeferredOps, 1, NULL);
-    nvKmsKapiReapQuarantine();
+        kms_close_overflow_drain_locked();
+        nvKmsKapiReapQuarantine();
         kms_close_retry_schedule_locked();
     }
     IOLockUnlock(gKmsLock);
@@ -194,8 +224,11 @@
 static void kms_close_remember_locked(struct nvkms_per_open *popen)
 {
     if (kms_deferred_push(popen, popen->data) != 0) {
-        // Capacity exhaustion is still unresolved: keep memory alive, report, never claim reclamation.
-        kprintf("NVRM-xnu: deferred-close table full/conflicting; wrapper retained without a queue slot\n");
+        popen->nextOverflow = gKmsCloseOverflow;
+        gKmsCloseOverflow = popen;
+        gKmsCloseOverflowCount++;
+        kprintf("NVRM-xnu: deferred-close table full/conflicting; close of %p queued for overflow reclamation "
+                "(count %u)\n", popen, gKmsCloseOverflowCount);
     }
     kms_close_retry_schedule_locked();
 }
