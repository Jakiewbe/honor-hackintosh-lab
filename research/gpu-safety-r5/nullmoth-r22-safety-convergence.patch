@@ -100,6 +100,10 @@ class NMIntelFB : public IOFramebuffer {
         thread_call_enter_delayed(me->fVblTimer, me->fVblNext);
     }
     void armVbl() {
+        // The call holds a reference on this object: a callback may still run (and dereference `me`)
+        // after stop() gives up freeing it, so the object must outlive the call. Whichever finishes
