+// Internal bridge-only API. The UserClient session lock owns popen across
+// the PM wait. Never use this API for a KAPI Device or its event worker.
+NvBool nvkms_xnu_try_close_bridge(struct nvkms_per_open *popen)
+{
+    if (!popen) return NV_TRUE;
+    IOLockLock(gKmsLock);
+    if (popen->device || popen->eventCall || popen->type != NVKMS_CLIENT_KERNEL_SPACE) {
+        IOLockUnlock(gKmsLock);
+        return NV_FALSE;
+    }
+    if (!kms_pm_wait_locked(false, kKmsPmWaitMs)) {
+        IOLockUnlock(gKmsLock);
+        return NV_FALSE; // Keep both the real per-open and its owning wrapper.
+    }
+    // Suspend takes gKmsLock before closing the RM gate. Keep this lock from
+    // the successful PM check through backend close; there is no KAPI worker.
+    if (popen->data) nvKmsClose(popen->data);
+    popen->data = NULL;
+    popen->closing = true;
+    IOLockUnlock(gKmsLock);
+    nvkms_free(popen, sizeof *popen);
+    return NV_TRUE;
+}
