+extern "C" int nv_xnu_retry_kms_bridge_closes(void)
+{
+    // Internal, explicit control-context retry. Never run on an event callback
+    // or while holding NVKMS/RM locks; no implicit work on the PM thread.
+    if (!gNvClientsLock) return 0;
+    int pending = 0;
+    for (int i = 0; i < NV_XNU_MAX_CLIENTS; i++) {
+        IOLockLock(gNvClientsLock);
+        NVRMUserClient *client = gNvClients[i];
+        if (client) client->retain();
+        IOLockUnlock(gNvClientsLock);
+        if (!client) continue;
+        if (client->retryKmsClose() != kIOReturnSuccess) pending++;
+        client->release();
+    }
+    return pending;
+}
