+// A stop path that ran while NVKMS could not be called left the shared device behind, with the
+// modeset ownership the dead framebuffer grabbed and never released. A later start only happens
+// while NVKMS is callable, so the orphan is finished here rather than leaking for every suspend
+// cycle. If NVKMS is still not callable the device stays for the next attempt.
+void NVRMNVDAFramebuffer::finishOrphanedDevice()
+{
+    if (!gDevOrphaned || !gDev) return;
+    if (!nvkms_xnu_pm_running()) {
+        FBLOG("orphaned device 0x%llx still kept: NVKMS is not running",
+              (unsigned long long)(uintptr_t)gDev);
+        return;
+    }
+    fKms->releaseOwnership(gDev);   // the orphan held exactly the one grab its start took
+    fKms->freeDevice(gDev);
+    gDev = nullptr;
+    gDevOrphaned = false;
+    gDevUsers = 0;
+    FBLOG("orphaned shared NvKmsKapiDevice released before binding a new one");
+}
