+        if (gOrphanGrab) { fKms->releaseOwnership(gDev); gOrphanGrab = false; }
+        gDevOrphaned = false;
+        FBLOG("orphan settled without freeing: %d framebuffer(s) still drive device 0x%llx",
+              gDevUsers, (unsigned long long)(uintptr_t)gDev);
+        return;
+    }
+    if (gOrphanGrab) { fKms->releaseOwnership(gDev); gOrphanGrab = false; }
     fKms->freeDevice(gDev);
     gDev = nullptr;
     gDevOrphaned = false;
-    gDevUsers = 0;
-    FBLOG("orphaned shared NvKmsKapiDevice released before binding a new one");
+    if (gDevCreator) { NVRMNVDAFramebuffer *creator = gDevCreator; gDevCreator = nullptr; creator->release(); }
+    FBLOG("orphaned shared NvKmsKapiDevice released (no other user)");
 }
 
 bool NVRMNVDAFramebuffer::kapiInit()
@@ -757,6 +782,9 @@ bool NVRMNVDAFramebuffer::kapiInit()
         fDev = fKms->allocateDevice(&ap);
         if (!fDev) { FBLOG("allocateDevice(gpu 0x%x) failed", fGpuId); return false; }
         gDev = fDev;
+        // privateData/eventCallback were baked to this object; keep it alive until the device goes.
+        gDevCreator = this;
+        retain();
     }
     gDevUsers++;
     if (!fKms->grabOwnership(fDev)) { FBLOG("grabOwnership failed"); return false; }
