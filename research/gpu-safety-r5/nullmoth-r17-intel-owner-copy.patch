+// Owner-copy of one frame into this panel's own mapping. The caller keeps its source buffer; this side
+// validates the geometry against its mapping, takes the lock stop() also takes, and copies row by row,
+// so the destination can never be unmapped while a copy is in flight.
+IOReturn NMIntelFB::copyToScanout(struct NVRMVramCopyRequest *r)
+{
+    if (!r || r->version != NVRM_VRAM_ABI_VERSION) return kIOReturnBadArgument;
+    if (fStopping || !fSurfMap || !fCopyLock) return kIOReturnNotReady;
+    if (!r->src || !r->width || !r->height) return kIOReturnBadArgument;
+    if ((r->srcPitch & 3u) || r->srcPitch < r->width * 4u) return kIOReturnBadArgument;
+    if (r->width > fWidth || r->height > fHeight) return kIOReturnBadArgument;
+
+    IOLockLock(fCopyLock);
+    IOReturn ret = kIOReturnSuccess;
+    if (fStopping || !fSurfMap) {
+        ret = kIOReturnNotReady;                     // stop() began while we waited for the lock
+    } else {
+        const unsigned char *s = (const unsigned char *)r->src;
+        unsigned char *d = (unsigned char *)fSurfMap->getVirtualAddress();
+        if (!d) {
+            ret = kIOReturnNotReady;
+        } else {
+            const unsigned rowb = r->width * 4u;
+            for (unsigned y = 0; y < r->height; y++) {
+                volatile unsigned int *dp = (volatile unsigned int *)(d + (unsigned long)y * fRowBytes);
+                const volatile unsigned int *sp = (const volatile unsigned int *)(s + (unsigned long)y * r->srcPitch);
+                for (unsigned x = 0; x < rowb / 4u; x++) dp[x] = sp[x];
+            }
+            r->dstPitch = fRowBytes;
+        }
+    }
+    IOLockUnlock(fCopyLock);
+    return ret;
+}
