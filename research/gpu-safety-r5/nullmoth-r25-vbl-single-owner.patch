     static void vblFire(thread_call_param_t p0, thread_call_param_t) {
         NMIntelFB *me = (NMIntelFB *)p0;
-        if (me->fStopping) { me->release(); return; }   // stop() could not free the call: we own the ref
+        if (me->fStopping) {
+            // stop() could not free the call, so the reference is still ours; clear before releasing so a
