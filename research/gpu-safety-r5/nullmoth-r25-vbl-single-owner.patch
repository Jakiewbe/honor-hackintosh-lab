+            retain();
+            fVblRefOwned = true;
+            uint64_t d; clock_interval_to_deadline((uint32_t)(fFrameNs / 1000), kMicrosecondScale, &d);
+            fVblNext = d; thread_call_enter_delayed(fVblTimer, d);
+        }
+        IFBLOG("vbl timer %s", fVblTimer ? "armed (60 Hz)" : "ALLOCATE FAILED (no reference taken)");
     }
 #ifdef NMINTELFB_VIRTUAL
     IOBufferMemoryDescriptor *fVBuf = nullptr;
@@ -405,7 +417,8 @@ void NMIntelFB::stop(IOService *provider)
             // The callback may still be running and will release the reference itself.
