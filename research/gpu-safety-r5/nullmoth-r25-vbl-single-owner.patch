--- a/kexts/NMIntelFB/intelfb.cpp
+++ b/kexts/NMIntelFB/intelfb.cpp
@@ -88,11 +88,19 @@ class NMIntelFB : public IOFramebuffer {
     struct Irq { IOFBInterruptProc proc = nullptr; OSObject *target = nullptr; void *ref = nullptr; };
     Irq fVbl, fConnect;
     thread_call_t fVblTimer = nullptr;
+    // True while the thread call owns a reference on this object; exactly one path clears it and
