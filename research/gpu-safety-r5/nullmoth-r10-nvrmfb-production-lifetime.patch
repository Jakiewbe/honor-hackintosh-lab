+// Undo what this framebuffer bound: its head bit, its modeset ownership and - once no other
+// framebuffer drives it - the shared device. KAPI teardown reaches NVKMS through
+// nvkms_ioctl_from_kapi(), which waits on the PM gate (up to 30 s) and is refused when the GPU is
+// LOST while FreeDevice() still frees the RM half; a stop path must not run that, so a device is
+// only dropped while NVKMS can touch the GPU, otherwise it is kept and the leak is logged.
+// Answered by the NVKMS OS layer: false while NVKMS is suspended or LOST. KAPI teardown
+// (releaseOwnership/freeDevice) reaches NVKMS through nvkms_ioctl_from_kapi, which waits on
+// the PM gate and is refused once the GPU is LOST - a stop path must not tear down there.
+extern "C" NvBool nvkms_xnu_pm_running(void);
+void NVRMNVDAFramebuffer::dropKapiDevice()
+{
+    if (fOwnsHead) { gHeadsTaken &= ~(1u << fHead); fOwnsHead = false; }
+    if (!fDev) return;
+    if (!nvkms_xnu_pm_running()) {
+        FBLOG("device 0x%llx kept: NVKMS is not running -- teardown would block or split RM state",
+              (unsigned long long)(uintptr_t)fDev);
+        return;
+    }
+    if (fGrabbedOwnership) { fKms->releaseOwnership(fDev); fGrabbedOwnership = false; }
+    const int remaining = --gDevUsers;
+    if (remaining > 0) {
+        FBLOG("device 0x%llx kept: %d other framebuffer(s) still drive it",
+              (unsigned long long)(uintptr_t)fDev, remaining);
+        fDev = nullptr;
+        return;
+    }
+    fKms->freeDevice(fDev);
+    if (gDev == fDev) gDev = nullptr;
+    fDev = nullptr;
+    FBLOG("shared NvKmsKapiDevice released (last user)");
+}
