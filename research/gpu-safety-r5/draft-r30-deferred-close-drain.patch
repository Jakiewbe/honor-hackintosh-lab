index 8332db5..e279be6 100644
--- a/kexts/NVRM/os-nvkms-xnu.cpp
+++ b/kexts/NVRM/os-nvkms-xnu.cpp
@@ -14,6 +14,7 @@ extern "C" {
 #include "nvidia-modeset-os-interface.h"
 #include "nv-gpu-info.h"
 #include "nvUnixVersion.h"
+#include "kms_deferred.h"
 }
 
 static inline void nvu_memset(void *p, int c, size_t n) { __asm__ __volatile__("rep stosb" : "+D"(p), "+c"(n) : "a"(c) : "memory"); }
@@ -142,6 +143,11 @@ static void kms_close_common(struct nvkms_per_open *popen)
     if (!kms_pm_wait_locked(false, kKmsPmWaitMs)) {
         popen->closing = true;
         popen->eventWanted = false;
+        // Remember the node so a later resume can finish the close. A full table is reported, not hidden:
+        // the per-open stays alive either way, and the counter below shows the backlog.
+        if (kms_deferred_push(popen, popen->data) != 0) {
+            kprintf("NVRM-xnu: deferred-close table is full; wrapper kept and tracked by the counter only\n");
+        }
         gKmsCloseDeferred++;
         if (gKmsPmState == kKmsPmLost) gKmsCloseDeferredLost++;
         IOLockUnlock(gKmsLock);
@@ -277,6 +283,35 @@ void nvkms_xnu_suspend_abort(uint32_t seq)
     IOLockUnlock(gKmsLock);
 }
 
+// Real implementations for the portable bookkeeping unit. Kept out of the unit so it stays testable.
+static void kms_deferred_close_impl(void *data, void *)
+{
+    nvKmsClose(data);
+}
+
+static int kms_deferred_try_free_impl(void *node, void *)
+{
+    struct nvkms_per_open *popen = (struct nvkms_per_open *)node;
+    if (popen->eventCall && popen->eventBusy) {
+        if (thread_call_cancel(popen->eventCall)) popen->eventBusy = false;
+        while (popen->eventBusy) IOLockSleep(gKmsLock, popen, THREAD_UNINT);
+    }
+    if (popen->eventCall && !thread_call_free(popen->eventCall)) {
+        // A pending or rearmed call keeps the argument alive; leave it queued for the next resume.
+        return 0;
+    }
+    popen->eventCall = NULL;
+    popen->data = NULL;
+    if (gKmsCloseDeferred) gKmsCloseDeferred--;
+    nvkms_free(popen, sizeof *popen);
+    return 1;
+}
+
+static const struct kms_deferred_ops kKmsDeferredOps = {
+    kms_deferred_close_impl,
+    kms_deferred_try_free_impl,
+};
+
 void nvkms_xnu_resume(NvU32 gpuId, NvBool gpuOk)
 {
     if (!gKmsLoaded) return;
@@ -289,6 +324,8 @@ void nvkms_xnu_resume(NvU32 gpuId, NvBool gpuOk)
     if (gpuOk && gKmsPmState == kKmsPmSuspended) nvKmsResume(gpuId);
     gKmsPmState = gpuOk ? kKmsPmRunning : kKmsPmLost;
     IOLockWakeup(gKmsLock, &gKmsPmState, false);
+    // Only a running GPU may touch the display engine, so the drain is gated on gpuOk.
+    kms_deferred_drain(&kKmsDeferredOps, gpuOk, NULL);
     IOLockUnlock(gKmsLock);
     if (gpuOk) nvKmsKapiSuspendResume(NV_FALSE);
     kprintf("NVRM-xnu: NVKMS %s (gpu 0x%x)\n", gpuOk ? "resumed" : "left LOST: the GPU did not resume", gpuId);
