+// Internal result API for the complete KAPI Device owner. Failure never queues
+// or frees popen: the caller retains Device, popen and creator for an explicit retry.
+// The caller holds a PM pin through every KMS/RM release. No callback join here.
+extern "C" NvBool nvkms_xnu_try_close_kapi(struct nvkms_per_open *popen)
+{
+    if (!popen) return NV_TRUE;
+    if (!gKmsLock) return NV_FALSE;
+    IOLockLock(gKmsLock);
+    if (popen->closing || !kms_pm_wait_locked(true, 0)) {
+        IOLockUnlock(gKmsLock);
+        return NV_FALSE;
+    }
+    if (popen->eventCall && popen->eventBusy) {
+        if (thread_call_cancel(popen->eventCall)) popen->eventBusy = false;
+        if (popen->eventBusy) {
+            IOLockUnlock(gKmsLock);
+            return NV_FALSE;
+        }
+    }
+    if (popen->eventCall && !thread_call_free(popen->eventCall)) {
+        IOLockUnlock(gKmsLock);
+        return NV_FALSE;
+    }
+    popen->eventCall = NULL;
+    popen->closing = true;
+    popen->eventWanted = false;
+    if (popen->data) nvKmsClose(popen->data);
+    popen->data = NULL;
+    popen->device = NULL;
+    nvkms_free(popen, sizeof *popen);
+    IOLockUnlock(gKmsLock);
+    return NV_TRUE;
+}
