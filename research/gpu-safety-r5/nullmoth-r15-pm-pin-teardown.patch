--- a/kexts/NVRM/os-nvkms-xnu.cpp
+++ b/kexts/NVRM/os-nvkms-xnu.cpp
@@ -39,6 +39,10 @@ static void kms_timer_drain(thread_call_param_t, thread_call_param_t);
 // of a GPU that lost power spins in nvEvoMakeRoom forever.
 enum { kKmsPmRunning = 0, kKmsPmSuspended = 1, kKmsPmLost = 2 };
 static int gKmsPmState = kKmsPmRunning;
+// A teardown that passed nvkms_xnu_pm_running() holds a pin: suspend waits for it, so the
+// release/free pair can no longer be cut in half between the check and the call.
+static int gKmsPmPins;
+static const uint32_t kKmsPmPinWaitMs = 5000;
 static const uint32_t kKmsPmWaitMs = 30000;
 static const char *const kKmsPmName[] = { "running", "suspended", "lost" };
 
@@ -191,6 +195,15 @@ void nvkms_xnu_suspend(NvU32 gpuId)
     if (!gKmsLoaded) return;
     nvKmsKapiSuspendResume(NV_TRUE);
     IOLockLock(gKmsLock);
+    if (gKmsPmPins > 0) {
+        uint64_t deadline = 0;
+        clock_interval_to_deadline(kKmsPmPinWaitMs, kMillisecondScale, &deadline);
+        while (gKmsPmPins > 0) {
+            if (IOLockSleepDeadline(gKmsLock, &gKmsPmPins, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) break;
+        }
+        if (gKmsPmPins > 0)
+            kprintf("NVRM-xnu: NVKMS suspend proceeded with %d teardown pin(s) still held\n", gKmsPmPins);
+    }
     const bool wasRunning = gKmsPmState == kKmsPmRunning;
     gKmsPmState = kKmsPmSuspended;
     if (wasRunning) nvKmsSuspend(gpuId);
@@ -211,6 +224,26 @@ void nvkms_xnu_resume(NvU32 gpuId, NvBool gpuOk)
 // True while NVKMS may touch the GPU. KAPI teardown (releaseOwnership/freeDevice) reaches NVKMS
 // through nvkms_ioctl_from_kapi, which waits on the PM gate and is refused once the GPU is LOST;
 // a caller that must not block (a framebuffer stop) has to ask before it tears anything down.
+// Take a pin before tearing a KAPI device down: it succeeds only while NVKMS can be called, and it
+// keeps suspend from moving the state under the release/free pair. Always pair with unpin.
+NvBool nvkms_xnu_pm_pin(void)
+{
+    if (!gKmsLock) return NV_FALSE;
+    IOLockLock(gKmsLock);
+    const NvBool ok = (gKmsPmState == kKmsPmRunning);
+    if (ok) gKmsPmPins++;
+    IOLockUnlock(gKmsLock);
+    return ok;
+}
+void nvkms_xnu_pm_unpin(void)
+{
+    if (!gKmsLock) return;
+    IOLockLock(gKmsLock);
+    if (gKmsPmPins > 0) gKmsPmPins--;
+    if (gKmsPmPins == 0) IOLockWakeup(gKmsLock, &gKmsPmPins, false);
+    IOLockUnlock(gKmsLock);
+}
+
 NvBool nvkms_xnu_pm_running(void)
 {
     if (!gKmsLock) return NV_FALSE;
