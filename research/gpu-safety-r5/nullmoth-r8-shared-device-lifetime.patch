+// kapiInit binds this framebuffer to the one shared NvKmsKapiDevice. Whoever binds it must be able
+// to unbind it again: the device's privateData and eventCallback point at this framebuffer, so it
+// must never outlive the last framebuffer that drives it, and it must not stay reachable through
+// gDev after the owner failed to start. Ownership is released per instance (the grab in kapiInit is
+// not a no-op), and only the last holder calls freeDevice(). freeDevice() returns void, so a
+// teardown failure cannot be reported - the log is the only signal.
+void NVRMNVDAFramebuffer::dropKapiDevice()
+{
+    if (fHeadBit) { gHeadsTaken &= ~fHeadBit; fHeadBit = 0; }
+    if (!fDev) return;
+    if (fGrabbedOwnership) { fKms->releaseOwnership(fDev); fGrabbedOwnership = false; }
+    const int remaining = --gDevUsers;
+    if (remaining > 0) {
+        FBLOG("device 0x%llx kept: %d other framebuffer(s) still drive it",
+              (unsigned long long)(uintptr_t)fDev, remaining);
+        fDev = nullptr;
+        return;
+    }
+    fKms->freeDevice(fDev);
+    if (gDev == fDev) gDev = nullptr;
+    fDev = nullptr;
+    FBLOG("shared NvKmsKapiDevice released (last user)");
+}
