diff --git a/kexts/NVRM/os-nvkms-xnu.cpp b/kexts/NVRM/os-nvkms-xnu.cpp
index 0cdba77..546ff61 100644
--- a/kexts/NVRM/os-nvkms-xnu.cpp
+++ b/kexts/NVRM/os-nvkms-xnu.cpp
@@ -208,6 +208,18 @@ void nvkms_xnu_resume(NvU32 gpuId, NvBool gpuOk)
     if (gpuOk) nvKmsKapiSuspendResume(NV_FALSE);
     kprintf("NVRM-xnu: NVKMS %s (gpu 0x%x)\n", gpuOk ? "resumed" : "left LOST: the GPU did not resume", gpuId);
 }
+// True while NVKMS may touch the GPU. KAPI teardown (releaseOwnership/freeDevice) reaches NVKMS
+// through nvkms_ioctl_from_kapi, which waits on the PM gate and is refused once the GPU is LOST;
+// a caller that must not block (a framebuffer stop) has to ask before it tears anything down.
+NvBool nvkms_xnu_pm_running(void)
+{
+    if (!gKmsLock) return NV_FALSE;
+    IOLockLock(gKmsLock);
+    const NvBool running = (gKmsPmState == kKmsPmRunning);
+    IOLockUnlock(gKmsLock);
+    return running;
+}
