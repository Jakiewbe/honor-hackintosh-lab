diff --git a/kexts/NVRM/accel/frame_copy_checked.h b/kexts/NVRM/accel/frame_copy_checked.h
new file mode 100644
--- /dev/null
+++ b/kexts/NVRM/accel/frame_copy_checked.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: MIT
+// Bounded CPU copy only. The caller owns both mappings and must prove GPU completion.
+#ifndef HONOR_FRAME_COPY_CHECKED_H
+#define HONOR_FRAME_COPY_CHECKED_H
+
+static inline bool honorCopyFrame32(volatile unsigned int *dst, unsigned long long dstLength,
+                                   unsigned dstPitch, const volatile unsigned int *src,
+                                   unsigned long long srcLength, unsigned srcPitch,
+                                   unsigned width, unsigned height)
+{
+    static_assert(sizeof(unsigned int) == 4, "32-bit pixel words required");
+    if (!dst || !src || !width || !height) return false;
+    const unsigned long long row = (unsigned long long)width * 4;
+    if (row > srcPitch || row > dstPitch || (srcPitch & 3u) || (dstPitch & 3u)) return false;
+    const unsigned long long srcSpan = (unsigned long long)(height - 1) * srcPitch + row;
+    const unsigned long long dstSpan = (unsigned long long)(height - 1) * dstPitch + row;
+    if (srcSpan > srcLength || dstSpan > dstLength) return false;
+    const __UINTPTR_TYPE__ sb = (__UINTPTR_TYPE__)src, db = (__UINTPTR_TYPE__)dst;
+    const __UINTPTR_TYPE__ max = ~(__UINTPTR_TYPE__)0;
+    if ((sb & 3u) || (db & 3u) || srcSpan > max - sb || dstSpan > max - db) return false;
+    if (sb < db + dstSpan && db < sb + srcSpan) return false;
+    for (unsigned y = 0; y < height; ++y) {
+        const volatile unsigned int *s = src + (unsigned long long)y * (srcPitch / 4);
+        volatile unsigned int *d = dst + (unsigned long long)y * (dstPitch / 4);
+        for (unsigned x = 0; x < width; ++x) d[x] = s[x];
+    }
+    return true;
+}
+
+#endif
