+// Task counters protect bring-up workers, not arbitrary RM clients or PM.
+bool NVRM::beginTask()
+{
+    if (!gNvClientsLock) return false;
+    IOLockLock(gNvClientsLock);
+    const bool admit = !fTaskStopping && !isInactive();
+    if (admit) { ++fTasks; retain(); }
+    IOLockUnlock(gNvClientsLock);
+    return admit;
+}
+bool NVRM::taskStopping()
+{
+    if (!gNvClientsLock) return true;
+    IOLockLock(gNvClientsLock);
+    const bool stopping = fTaskStopping || isInactive();
+    IOLockUnlock(gNvClientsLock);
+    return stopping;
+}
+bool NVRM::taskSleep(uint32_t ms)
+{
+    while (ms && !taskStopping()) {
+        const uint32_t step = ms > 50 ? 50 : ms;
+        IOSleep(step); ms -= step;
+    }
+    return !taskStopping();
+}
+void NVRM::closeTaskAdmission()
+{
+    if (gNvClientsLock) IOLockLock(gNvClientsLock);
+    fTaskStopping = true;
+    if (gNvClientsLock) IOLockUnlock(gNvClientsLock);
+    releaseBootHold("service terminating");
+}
+void NVRM::completeTaskTermination()
+{
+    IOLockLock(gNvClientsLock);
+    const bool ready = fTasks == 0 && (!fTaskDeferProvider || fTaskDeferReady) &&
+        (fTaskDeferProvider || (fTaskFinalizePending && !fTaskFinalizeDone));
+    IOLockUnlock(gNvClientsLock);
+    if (!ready) return;
+    // Match XNU _workLoopAction: use the service/provider loop, NOT our MSI loop.
+    // No private lock is held while taking the IOKit work-loop gate.
+    if (IOWorkLoop *loop = getWorkLoop()) {
+        loop->retain();
+        const IOReturn status = loop->runAction(&NVRM::taskCompletionAction, this);
+        loop->release();
+        // Ownership is taken only inside the action. A dispatch failure retains it.
+        if (status != kIOReturnSuccess) LOG("task termination dispatch failed: 0x%x; completion retained", status);
+    } else {
+        finishTaskTermination();
+    }
+}
+
+IOReturn NVRM::taskCompletionAction(OSObject *owner, void *, void *, void *, void *)
+{
+    ((NVRM *)owner)->finishTaskTermination();
+    return kIOReturnSuccess;
+}
+
+void NVRM::finishTaskTermination()
+{
+    IOService *provider = NULL; IOOptionBits options = 0, finalOptions = 0;
+    bool finalizeNow = false;
+    IOLockLock(gNvClientsLock);
+    // Both completion channels wait for the first didTerminate call to return.
+    if (fTasks == 0 && (!fTaskDeferProvider || fTaskDeferReady)) {
+        if (fTaskDeferProvider) {
+            provider = fTaskDeferProvider; options = fTaskDeferOptions;
+            fTaskDeferProvider = NULL; fTaskDeferReady = false; fTaskTerminateDone = true;
+        }
+        if (fTaskFinalizePending && !fTaskFinalizeDone) {
+            finalOptions = fTaskFinalizeOptions;
+            fTaskFinalizePending = false; fTaskFinalizeDone = true; finalizeNow = true;
+        }
+    }
+    IOLockUnlock(gNvClientsLock);
+    // The task caller or IOKit caller still owns self here. No private lock across IOKit.
+    if (provider) {
+        bool defer = false;
+        super::didTerminate(provider, options, &defer);
+        provider->release();
+    }
+    if (finalizeNow) super::finalize(finalOptions);
+}
+void NVRM::endTask()
+{
+    IOLockLock(gNvClientsLock);
+    if (fTasks == 0) { IOLockUnlock(gNvClientsLock); LOG("ERROR: task accounting underflow"); return; }
+    --fTasks;
+    IOLockUnlock(gNvClientsLock);
+    completeTaskTermination();
+    release();
+}
+bool NVRM::willTerminate(IOService *provider, IOOptionBits options)
+{
+    closeTaskAdmission();
+    return super::willTerminate(provider, options);
+}
+bool NVRM::didTerminate(IOService *provider, IOOptionBits options, bool *defer)
+{
+    closeTaskAdmission();
+    *defer = false;
+    if (!gNvClientsLock) return super::didTerminate(provider, options, defer);
+    IOLockLock(gNvClientsLock);
+    if (fTaskTerminateDone) { *defer = false; IOLockUnlock(gNvClientsLock); return true; }
+    if (fTaskDeferProvider) { *defer = true; IOLockUnlock(gNvClientsLock); return true; }
+    if (fTasks == 0) {
+        fTaskTerminateDone = true;
+        IOLockUnlock(gNvClientsLock);
+        return super::didTerminate(provider, options, defer);
+    }
+    provider->retain(); fTaskDeferProvider = provider; fTaskDeferOptions = options;
+    // endTask cannot complete until the initial superclass defer registration has returned.
+    fTaskDeferReady = false; *defer = true;
+    IOLockUnlock(gNvClientsLock);
+    const bool result = super::didTerminate(provider, options, defer);
+    IOLockLock(gNvClientsLock);
+    fTaskDeferReady = true;
+    IOLockUnlock(gNvClientsLock);
+    completeTaskTermination();
+    return result;
+}
+
+bool NVRM::finalize(IOOptionBits options)
+{
+    closeTaskAdmission();
+    if (!gNvClientsLock) return super::finalize(options);
+    IOLockLock(gNvClientsLock);
+    if (!fTaskFinalizePending && !fTaskFinalizeDone) {
+        fTaskFinalizePending = true; fTaskFinalizeOptions = options;
+    }
+    IOLockUnlock(gNvClientsLock);
+    // XNU ignores this bool. Delaying the BASE call, not returning true, prevents
+    // finalize's independent stop enqueue while counted work still owns hardware.
+    completeTaskTermination();
+    return true;
+}
+
+bool NVRM::adoptAdapter(IOWorkLoop *loop, IOFilterInterruptEventSource *source)
+{
+    IOLockLock(gNvClientsLock);
+    // RM succeeded: this is cleanup ownership, including when cancellation won.
+    fWorkLoop = loop; fIntSrc = source; fAdapter = true;
+    const bool ready = !fTaskStopping && !isInactive();
+    if (ready) fPassDone = 2;
+    IOLockUnlock(gNvClientsLock);
+    return ready;
+}
