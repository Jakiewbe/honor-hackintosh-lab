        CreateByteField (BUFF, Zero, STAT)
        CreateByteField (Arg0, 0x02, SSRN)
        CreateByteField (Arg0, 0x04, TUPF)
        CreateByteField (Arg0, 0x05, TUPL)
        CreateByteField (Arg0, 0x06, TDNF)
        CreateByteField (Arg0, 0x07, TDNL)
        Local1 = Zero
        STAT = Zero
        If ((TUPF == One))
        {
            TUPL = ~TUPL /* \STMT.TUPL */
            TUPL += One
        }

        If ((TDNF == One))
        {
            TDNL = ~TDNL /* \STMT.TDNL */
            TDNL += One
        }

        If ((TUPF == Zero))
        {
            If ((TDNF == Zero))
            {
                If ((TDNL > TUPL))
                {
                    STAT = One
                }
            }
        }

        If ((TUPF == One))
        {
            If ((TDNF == One))
            {
                If ((TDNL > TUPL))
                {
                    STAT = One
                }
            }
            ElseIf ((TDNF == Zero))
