        {
            If ((Arg1 == One))
            {
                RETN = 0xCC
            }

            If ((Arg1 == 0x03))
            {
                RETN = 0xCC
            }

            If ((Arg1 == 0x04))
            {
                RETN = 0xCC
            }

            If ((Arg1 == 0x12))
            {
                RETN = 0xCC
            }

            If ((Arg1 == 0x13))
            {
                RETN = 0xCC
            }

            If ((Arg1 == 0x14))
            {
                RETN = 0xCC
            }
        }

        If ((Arg0 == 0x04)){}
        Return (RETN) /* \NORN.RETN */
    }

