    }

    Method (IBE3, 0, Serialized)
    {
        Local0 = 0x03E8
        While ((PO6C & 0x02))
        {
            Local0--
            If ((Local0 == Zero))
            {
                Break
            }

            Sleep (0x0A)
        }
    }

    Method (OBF3, 0, Serialized)
    {
        Local0 = 0x03E8
        While (!(PO6C & One))
        {
            Local0--
            If ((Local0 == Zero))
            {
                Break
            }

            Sleep (0x0A)
        }
    }

