                    \_SB.PC00.LPCB.EC0.DRDF = Zero
                    \_SB.PC00.LPCB.EC0.TFUD = Zero
                    \_SB.PC00.LPCB.EC0.TFDD = Zero
                }
                ElseIf ((SSRN == 0x06))
                {
