        Local0 = Arg0
        CreateByteField (BUFF, Zero, STAT)
        STAT = Zero
        CreateByteField (Arg0, 0x02, FNMB)
        CreateByteField (Arg0, 0x03, FRPM)
        If ((FNMB == Zero))
        {
            SECD (0xD5, 0x11)
            Sleep (0x14)
            SECD (0xD6, FRPM)
        }
        ElseIf ((FNMB == One))
        {
            SECD (0xD5, 0x11)
            Sleep (0x14)
            SECD (0xD7, FRPM)
        }
        Else
        {
            STAT = One
        }

        Return (BUFF) /* \SFNS.BUFF */
    }

