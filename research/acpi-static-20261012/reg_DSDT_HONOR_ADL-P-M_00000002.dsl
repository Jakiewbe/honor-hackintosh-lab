                    \_SB.PC00.LPCB.EC0.CPUF = Zero
                    \_SB.PC00.LPCB.EC0.CPDF = Zero
                    \_SB.PC00.LPCB.EC0.TFUC = Zero
                    \_SB.PC00.LPCB.EC0.TFDC = Zero
                }
