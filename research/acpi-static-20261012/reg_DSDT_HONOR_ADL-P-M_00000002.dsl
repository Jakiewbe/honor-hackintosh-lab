        {
            \_SB.TPM.PTS (Arg0)
        }

        SPTS (Arg0)
        If (CondRefOf (\DTFS))
        {
            If ((DTFS == One))
            {
                If (CondRefOf (TPTS))
                {
                    TPTS (Arg0)
