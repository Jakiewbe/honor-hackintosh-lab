                    {
                        \_SB.PC00.RP17.NFRP ()
                    }

                    If (CondRefOf (\_SB.PC00.RP21.NFRP))
                    {
                        \_SB.PC00.RP21.NFRP ()
                    }

                    If (CondRefOf (\_SB.PC00.RP25.NFRP))
                    {
                        \_SB.PC00.RP25.NFRP ()
                    }
                }
            }

            If (CondRefOf (\_SB.PC00.TXHC))
            {
                \_SB.TCWK (Arg0)
            }
        }

        If (((Arg0 == 0x03) || (Arg0 == 0x04))){}
        If (CondRefOf (\DTFS))
        {
            If ((DTFS == One))
            {
                Signal (WFEV)
            }
        }

