                    \_SB.PC00.LPCB.EC0.SYUF = Zero
                    \_SB.PC00.LPCB.EC0.SYDF = Zero
                    \_SB.PC00.LPCB.EC0.TFUL = Zero
                    \_SB.PC00.LPCB.EC0.TFDL = Zero
                }
                ElseIf ((SSRN == 0x0B))
                {
