+void NVRM::stop(IOService *provider)
+{
+    // B8: refuse new go() requests while stop processes this device.
+    // This is admission control, not proof that an already running go()
+    // has finished or that GSP/DMA/interrupts are quiescent.
+    if (gNvClientsLock) {
+        IOLockLock(gNvClientsLock);
+        fStopping = 1;
+        IOLockUnlock(gNvClientsLock);
+    } else {
+        fStopping = 1;
+    }
+    releaseBootHold("device stopping");
     if (fAdapter) { rm_shutdown_adapter(NULL, &fNv); fAdapter = false; }
