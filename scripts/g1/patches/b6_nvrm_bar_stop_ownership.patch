-void NVRM::readBARs()
+void NVRM::releaseBarStopSnapshot()
+{
+    // Release only saved object references; this does NOT modify PCI hardware.
+    if (fBarOriginalMemory) { fBarOriginalMemory->release(); fBarOriginalMemory = NULL; }
+    if (fBarRootPort) { fBarRootPort->release(); fBarRootPort = NULL; }
+    fBarStopRestorePending = false;
+}
+
+bool NVRM::restorePlacedBar1ForStop()
+{
+    if (!fBarStopRestorePending) return true;
+    auto blocked = [&](const char *why) -> bool {
+        fBarStopRestoreFailed = true;
+        setProperty("nvrm-bar1-stop-restore", why);
+        LOG("bar1: stop restoration BLOCKED: %s", why);
+        return false;
+    };
+    // Never overwrite PCI registers after a failed RM/GSP initialization:
+    // ownership of DMA, interrupts and firmware state is still unknown.
+    if (fAdapterInitFailed || fAdapter)
+        return blocked("RM/GSP adapter not proven quiescent");
+    if (!fPCI || !fBarRootPort || !fBarOriginalMemory)
+        return blocked("BAR ownership snapshot unavailable");
+    IOPCIDevice *rp = fBarRootPort;
+    // Do not clobber any external PCI reconfiguration made since placement.
+    for (unsigned i = 0; i < 4; i++)
+        if (fPCI->configRead32(0x14 + 4 * i) != fBarPlacedGpuRegs[i])
+            return blocked("GPU BAR modified by another owner");
+    if (rp->configRead32(0x24) != fBarPlacedPortRegs[0] ||
+        rp->configRead32(0x28) != fBarPlacedPortRegs[1] ||
+        rp->configRead32(0x2c) != fBarPlacedPortRegs[2])
+        return blocked("Root Port prefetchable window modified by another owner");
+    if (fBarRebarCtlOffset &&
+        fPCI->extendedConfigRead32(fBarRebarCtlOffset) != fBarRebarPlaced)
+        return blocked("Resizable BAR changed by another owner");
+
+    // We cannot prove DMA has drained while the PCI bus-master bit is set.
+    // Do not forcefully disable a potentially live GPU during this experiment.
+    UInt16 currentCommand = fPCI->configRead16(0x04);
+    if (currentCommand & 0x4)
+        return blocked("PCI bus master still enabled; DMA quiescence unknown");
+
+    fPCI->configWrite16(0x04, currentCommand & ~(UInt16)0x6);
+    rp->configWrite32(0x24, 0x0000fff0);
+    if (fBarRebarCtlOffset)
+        fPCI->extendedConfigWrite32(fBarRebarCtlOffset, fBarRebarOriginal);
+    fPCI->configWrite32(0x14, fBarOriginalGpuRegs[0]);
+    fPCI->configWrite32(0x18, fBarOriginalGpuRegs[1]);
+    fPCI->configWrite32(0x1c, fBarOriginalGpuRegs[2]);
+    fPCI->configWrite32(0x20, fBarOriginalGpuRegs[3]);
+    rp->configWrite32(0x28, fBarOriginalPortRegs[1]);
+    rp->configWrite32(0x2c, fBarOriginalPortRegs[2]);
+    rp->configWrite32(0x24, fBarOriginalPortRegs[0]);
+
+    bool restored =
+        fPCI->configRead32(0x14) == fBarOriginalGpuRegs[0] &&
+        fPCI->configRead32(0x18) == fBarOriginalGpuRegs[1] &&
+        fPCI->configRead32(0x1c) == fBarOriginalGpuRegs[2] &&
+        fPCI->configRead32(0x20) == fBarOriginalGpuRegs[3] &&
+        rp->configRead32(0x24) == fBarOriginalPortRegs[0] &&
+        rp->configRead32(0x28) == fBarOriginalPortRegs[1] &&
+        rp->configRead32(0x2c) == fBarOriginalPortRegs[2] &&
+        (!fBarRebarCtlOffset || fPCI->extendedConfigRead32(fBarRebarCtlOffset) == fBarRebarOriginal);
+    if (!restored)
+        return blocked("PCI restore readback mismatch; memory/bus mastering remain disabled");
+
+    fPCI->setDeviceMemory(fBarOriginalMemory);
+    fPCI->configWrite16(0x04, fBarOriginalCommand);
+    if (fPCI->configRead16(0x04) != fBarOriginalCommand)
+        return blocked("PCI command restore readback mismatch");
+    setProperty("nvrm-bar1-stop-restore", "RESTORED: original PCI config and IOKit apertures");
+    LOG("bar1: stop restored original PCI configuration and aperture descriptors");
+    return true;
+}
