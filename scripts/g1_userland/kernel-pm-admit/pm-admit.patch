+// Write the refusal into the single status field that this op's NVKMS caller reads back (nvkms-rmapi-dgpu.c returns
+// ops.params.<op>.status). False means the op has no status word known here, i.e. the refusal cannot be reported at
+// all - a gap, to be logged as one rather than papered over.
+static bool nvkms_rm_refuse_status(nvidia_kernel_rmapi_ops_t *o, NvU32 status)
+{
+    switch (o->op) {
+    case NV01_FREE:                o->params.free.status = status; return true;
+    case NV01_ALLOC_MEMORY:        o->params.allocMemory64.status = status; return true;
+    case NV04_ALLOC:               o->params.alloc.status = status; return true;
+    case NV04_VID_HEAP_CONTROL:    if (!o->params.pVidHeapControl) return false;
+                                   o->params.pVidHeapControl->status = status; return true;
+    case NV04_MAP_MEMORY:          o->params.mapMemory.status = status; return true;
+    case NV04_UNMAP_MEMORY:        o->params.unmapMemory.status = status; return true;
+    case NV04_ALLOC_CONTEXT_DMA:   o->params.allocContextDma2.status = status; return true;
+    case NV04_MAP_MEMORY_DMA:      o->params.mapMemoryDma.status = status; return true;
+    case NV04_UNMAP_MEMORY_DMA:    o->params.unmapMemoryDma.status = status; return true;
+    case NV04_BIND_CONTEXT_DMA:    o->params.bindContextDma.status = status; return true;
+    case NV04_CONTROL:             o->params.control.status = status; return true;
+    case NV04_DUP_OBJECT:          o->params.dupObject.status = status; return true;
+    case NV04_SHARE:               o->params.share.status = status; return true;
+    case NV04_ADD_VBLANK_CALLBACK: o->params.addVblankCallback.status = status; return true;
+    default:                       return false;
+    }
+}
