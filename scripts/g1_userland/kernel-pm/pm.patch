+// Reopen the gate after a sleep that was abandoned. The PM owner is cleared so later RM calls are admitted again;
+// this is the exact inverse of nv_xnu_pm_close() and is the only rollback path a failed suspend uses.
+static void nv_xnu_pm_abort(void)
+{
+    if (!gNvPmGate) return;
+    IOLockLock(gNvPmGate);
+    gNvPmClosed = false;
+    gNvPmOwner = NULL;
+    IOLockWakeup(gNvPmGate, &gNvPmClosed, false);
+    IOLockUnlock(gNvPmGate);
 }
