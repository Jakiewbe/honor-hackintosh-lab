+/* Experimental local candidate derived alongside NullMoth 272ccd9.
+ * SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+ * Include after nvmtl_prologue and nvmtl_submit_mutex. No stop/reset proof here.
+ */
+enum nvmtl_submit_phase {
+    NVMTL_OWNER_NOT_SUBMITTED = 1,
+    NVMTL_OWNER_ATTEMPTED = 2,
+    NVMTL_OWNER_SUBMITTED = 3
+};
+/* Private migration destinations only. This is actual ownership of the newly
+ * created handles, not a claim to pin arbitrary caller/ObjC/imported resources.
+ * Installed before begin/QueueSubmit. No stop/reset reclamation API exists. */
+typedef struct {
+    VkImage image;
+    VkImageView view;
+    VkBuffer buffer;
+    VkDeviceMemory memory;
+} nvmtl_submit_resources;
+struct nvmtl_inflight {
+    nvk_cmdbuf *c;
+    VkFence fence;
+    nvmtl_prologue pre;
+    uint64_t pt[8];
+    struct nvmtl_inflight *owner_next;
+    nvmtl_submit_resources resources;
+    nvk_cmdbuf retained_c;
+    void *retained_aux;
+    uint64_t owner_id;
+    unsigned phase, unresolved;
+};
+static nvmtl_inflight *nvmtl_submit_owners;
+static uint64_t nvmtl_submit_owner_sequence;
+
+static int nvmtl_owner_contains_locked(const nvmtl_inflight *f)
+{
+    for (nvmtl_inflight *p = nvmtl_submit_owners; p; p = p->owner_next)
+        if (p == f) return 1;
+    return 0;
+}
+int nvmtl_vk_inflight_pending(const nvmtl_inflight *f)
+{
+    pthread_mutex_lock(&nvmtl_submit_mutex);
+    const int pending = nvmtl_owner_contains_locked(f);
+    pthread_mutex_unlock(&nvmtl_submit_mutex);
+    return pending;
+}
+static void nvmtl_owner_register_locked(nvmtl_inflight *f, VkFence fence)
+{
+    f->fence = fence;
+    f->phase = NVMTL_OWNER_NOT_SUBMITTED;
+    f->owner_id = ++nvmtl_submit_owner_sequence;
+    f->owner_next = nvmtl_submit_owners;
+    nvmtl_submit_owners = f;
+}
+static void nvmtl_owner_retain(nvmtl_inflight *f)
+{
+    pthread_mutex_lock(&nvmtl_submit_mutex);
+    if (nvmtl_owner_contains_locked(f) && !f->unresolved) {
+        /* Move the owning aggregate, including its allocated arrays, off caller
+         * stacks. External ObjC resources still need the submission-part owner.
+         * This is an ownership transfer, never two independently freed copies. */
+        f->retained_c = *f->c;
+        memset(f->c, 0, sizeof *f->c);
+        f->c = &f->retained_c;
+        f->unresolved = 1;
+    }
+    pthread_mutex_unlock(&nvmtl_submit_mutex);
+}
+static void nvmtl_owner_completed(nvmtl_inflight *f)
+{
+    pthread_mutex_lock(&nvmtl_submit_mutex);
+    nvmtl_inflight **p = &nvmtl_submit_owners;
+    while (*p && *p != f) p = &(*p)->owner_next;
+    if (*p == f && !f->unresolved && f->phase == NVMTL_OWNER_SUBMITTED) {
+        *p = f->owner_next;
+        f->owner_next = NULL;
+        f->fence = VK_NULL_HANDLE;
+    }
+    pthread_mutex_unlock(&nvmtl_submit_mutex);
+}
+nvmtl_inflight *nvmtl_vk_inflight_new(void) { return calloc(1, sizeof(nvmtl_inflight)); }
+void nvmtl_vk_inflight_free(nvmtl_inflight *f)
+{
+    if (!f) return;
+    pthread_mutex_lock(&nvmtl_submit_mutex);
+    const int pending = nvmtl_owner_contains_locked(f);
+    if (!pending) free(f);
+    pthread_mutex_unlock(&nvmtl_submit_mutex);
+}
