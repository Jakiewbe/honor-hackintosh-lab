+  -DKERNEL -DKERNEL_PRIVATE -DDRIVER_PRIVATE -DAPPLE -DNeXT "${RMDEFS[@]}" ${NM_TAHOE:+-DNM_TAHOE} ${NM_SEQUOIA_24H32_FWD:+-DNM_SEQUOIA_24H32_FWD}   # NM_TAHOE=1: the macOS 26 build
